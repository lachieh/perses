{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    // The build task depends on all its upstream dependencies build tasks being run first
    "build": {
      "dependsOn": ["clean", "^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "dependsOn": [],
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "start": {
      // Make sure all packages are built once before starting watch mode
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "type-check": {
      // Make sure all packages are built once before type-checking to ensure
      // we have the right files for cross-package dependencies.
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "e2e:local": {
      "with": ["//#backend", "@perses-dev/app#start"],
      "dependsOn": ["//#wait-on-backend", "//#wait-on-app"],
      "outputs": [],
      "cache": false
    },
    "e2e:ci": {
      "dependsOn": [],
      "outputs": [],
      "cache": false
    },
    "//#backend": {
      "cache": false
    },
    "//#wait-on-backend": {
      "cache": false
    },
    "//#wait-on-app": {
      "cache": false
    }
  }
}
